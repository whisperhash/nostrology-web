DATABASE_URL=postgresql://nostr_brain:changeme@postgres:5432/nostr_brain

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). PUBLIC (exposed to the browser via
# $env/dynamic/public) and not a secret. Leave EMPTY to disable analytics entirely — this
# is the intended default for local dev, so `pnpm dev` never sends hits to production GA.
PUBLIC_GA_MEASUREMENT_ID=
